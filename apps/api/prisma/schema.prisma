generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TripStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ItineraryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ActivityStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobType {
  ITINERARY_GENERATION
  ITINERARY_UPDATE
  DISRUPTION_RECOVERY
  ACTIVITY_RECOMMENDATION
  BUDGET_OPTIMIZATION
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ------------------------------------------------------
// USER & SECURITY
// ------------------------------------------------------

model User {
  id                      String     @id @default(uuid()) @db.Uuid
  email                   String     @unique
  passwordHash            String
  name                    String?
  avatarUrl               String?
  phoneNumber             String?
  isEmailVerified         Boolean    @default(false)
  emailVerifiedAt         DateTime?
  status                  UserStatus @default(ACTIVE)

  // Verification & Password Reset Security Tokens
  verificationToken       String?    @unique
  verificationTokenExpiry DateTime?
  resetPasswordToken      String?    @unique
  resetPasswordTokenExpiry DateTime?

  // Timestamps
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  lastLoginAt             DateTime?

  // Relations
  sessions                Session[]
  trips                   Trip[]
  createdItineraries      Itinerary[] @relation("ItineraryCreator")
  savedPlaces             SavedPlace[]
  generationJobs          GenerationJob[]

  @@index([status])
  @@index([email])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique // Secure hash of session/refresh token
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------
// CORE TRIP & VERSIONED ITINERARIES
// ------------------------------------------------------

model Trip {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  title         String
  description   String?
  origin        String?
  destination   String
  startDate     DateTime        @db.Date
  endDate       DateTime        @db.Date
  status        TripStatus      @default(DRAFT)
  budget        Decimal?        @db.Decimal(12, 2)
  currency      String          @default("USD") @db.VarChar(3)
  travelerCount Int             @default(1)
  timezone      String?
  preferences   Json?           // Flexible preferences (pace, dietary, travel style)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraries   Itinerary[]
  generationJobs GenerationJob[]


  @@unique([userId, destination, startDate, endDate])
  @@index([userId, status])
  @@index([startDate, endDate])
}

model Itinerary {
  id              String          @id @default(uuid()) @db.Uuid
  tripId          String          @db.Uuid
  version         Int             @default(1)
  status          ItineraryStatus @default(DRAFT)
  title           String
  description     String?
  creatorId       String?         @db.Uuid
  generationJobId String?         @db.Uuid
  isCurrent       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator         User?           @relation("ItineraryCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  generationJob   GenerationJob?  @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  days            ItineraryDay[]

  @@unique([tripId, version])
  @@index([tripId, status])
  @@index([generationJobId])
}

model ItineraryDay {
  id          String     @id @default(uuid()) @db.Uuid
  itineraryId String     @db.Uuid
  dayNumber   Int
  date        DateTime?  @db.Date
  title       String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  itinerary   Itinerary  @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  activities  Activity[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
  @@index([date])
}

model Activity {
  id               String         @id @default(uuid()) @db.Uuid
  itineraryDayId   String         @db.Uuid
  placeId          String?        @db.Uuid
  title            String
  description      String?
  startTime        DateTime?
  endTime          DateTime?
  durationMinutes  Int?
  sortOrder        Int            @default(0)
  estimatedCost    Decimal?       @db.Decimal(12, 2)
  currency         String         @default("USD") @db.VarChar(3)
  status           ActivityStatus @default(PLANNED)
  bookingReference String?
  metadata         Json?          // Provider refs, confirmation notes, attachment links
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  itineraryDay     ItineraryDay   @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  place            Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([itineraryDayId, sortOrder])
  @@index([placeId])
  @@index([status])
}

// ------------------------------------------------------
// LOCATIONS & SAVED PLACES
// ------------------------------------------------------

model Place {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  address         String?
  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  category        String?      // e.g. ATTRACTION, RESTAURANT, HOTEL, AIRPORT, TRANSIT
  provider        String?      // e.g. GOOGLE_PLACES, MAPBOX, FOURSQUARE
  providerPlaceId String?
  metadata        Json?        // Phone, website, photos, openingHours, rating, priceLevel
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  activities      Activity[]
  savedByUsers    SavedPlace[]

  @@unique([provider, providerPlaceId])
  @@index([category])
  @@index([latitude, longitude])
}

model SavedPlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  placeId   String   @db.Uuid
  notes     String?
  category  String?  // Custom user collection tag (e.g., "Must Visit", "Cafes")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
}

// ------------------------------------------------------
// AI-READY GENERATION JOBS
// ------------------------------------------------------

model GenerationJob {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  tripId       String?     @db.Uuid
  jobType      JobType
  status       JobStatus   @default(PENDING)
  input        Json        // Prompts, constraints, recovery conditions, flight info
  result       Json?       // Generated itineraries, recovery options, trade-offs
  errorDetails Json?       // Error codes, failure categories, stack traces
  retryCount   Int         @default(0)
  maxRetries   Int         @default(3)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip         Trip?       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraries  Itinerary[]

  @@index([status])
  @@index([userId, status])
  @@index([tripId])
  @@index([jobType, status])
  @@index([createdAt])
}
